# Local development: Java runs on the host, infrastructure runs in Docker.
# Copy to .env and fill in the infrastructure passwords and JWT secret before starting.
MYSQL_DATABASE=ecommerce_management
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=

ECOMMERCE_DB_URL='jdbc:mysql://localhost:3307/ecommerce_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'
ECOMMERCE_DB_USERNAME=ecommerce
ECOMMERCE_DB_PASSWORD=

ECOMMERCE_REDIS_HOST=localhost
ECOMMERCE_REDIS_PORT=6379
ORDER_IDEMPOTENCY_TTL=24h
ORDER_IDEMPOTENCY_PROCESSING_TTL=5m
PAYMENT_STATUS_POLL_INTERVAL=30s

ECOMMERCE_RABBITMQ_HOST=localhost
ECOMMERCE_RABBITMQ_PORT=5672
ECOMMERCE_RABBITMQ_USER=ecommerce
ECOMMERCE_RABBITMQ_PASSWORD=

# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Optional one-time admin bootstrap. Set both or neither.
ADMIN_EMAIL=
ADMIN_PASSWORD=

RABBITMQ_MANAGEMENT_PORT=15672

# Dummy payment service runs on the host during local development.
DUMMY_PAYMENT_BASE_URL=http://localhost:8081
